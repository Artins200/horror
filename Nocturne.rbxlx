	flashLabel.Visible = false
	notice.Size = UDim2.fromScale(0.9, 0.12)
	notice.Position = UDim2.fromScale(0.05, 0.66)
	notice.TextSize = 21
	hiddenNote.Text = "ВЫЙТИ — СПРАВА  ·  ШКАФ ОПАСЕН"
